# Copy to .env and fill in. Never commit a populated .env.

OPENBIS_URL=https://openbis.imm.rwth-aachen.de

# Preferred: personal access token (PAT) created in the openBIS web UI
# under: User -> Personal Access Tokens
OPENBIS_TOKEN=

# Alternatively: read the token from a file (e.g. ~/.pybis/<host>.token)
# OPENBIS_TOKEN_FILE=~/.pybis/openbis.token

# Fallback: username + password (only used if OPENBIS_TOKEN / OPENBIS_TOKEN_FILE are empty)
# OPENBIS_USERNAME=
# OPENBIS_PASSWORD=

# Set to "false" only for development against a self-signed cert.
OPENBIS_VERIFY_CERTIFICATES=true

# Enable write tools (create/update/delete). Unset = read-only mode.
# OPENBIS_MCP_ALLOW_WRITE=1

# ---------------------------------------------------------------------------
# S3 configuration — required for the create_s3_linked_dataset tool.
#
# The S3 object key uses a collision-avoiding naming convention:
#   {timestamp}_{dataset_type}_{username}_{original_filename}
#
# Option A: individual environment variables
# ---------------------------------------------------------------------------
S3_ACCESS_KEY=
S3_ACCESS_SECRET=
S3_BUCKET=
S3_DMS_CODE=
# S3_REGION=eu-central-1
# S3_ENDPOINT_URL=https://s3.example.com
# S3_ENDPOINT_PORT=

# Option B: point at an INI config file (takes precedence over the vars above)
# S3_CONFIG_FILE=/path/to/s3.ini
